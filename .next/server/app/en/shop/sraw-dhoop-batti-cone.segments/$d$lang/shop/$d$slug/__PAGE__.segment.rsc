","reviews":"reviews","whatsappUs":"WhatsApp us","callUs":"Call us","email":"Email","home":"Home","shopAll":"Shop all products","becomeDealer":"Become a dealer","required":"required","selectOption":"Select an option","sendAnother":"Send another enquiry","optional":"Optional"},"nav":{"/shop":"Shop","/bulk-order":"Bulk order","/about":"About","/dealership":"Dealership","/contact":"Contact"},"navAccent":{"/shop":"उत्पाद","/bulk-order":"थोक","/about":"हमारे बारे में","/dealership":"डीलरशिप","/contact":"संपर्क"},"header":{"promoAccent":"शुभ आरंभ — हर सुबह की पहली सुगंध।","promo":"Free delivery on wholesale orders above ₹5,000"},"footer":{"quickLinks":"Quick links","products":"Products","contact":"Contact","tagline":"Pooja agarbatti, hand-rolled in Bihar since 2012.","taglineAccent":"हर पूजा में घर की सुगंध।","rights":"All rights reserved.","madeIn":"GST compliant · Made in Gaya, Bihar"},"loader":{"default":"Lighting the incense…","defaultAccent":"अगरबत्ती जल रही है…","shop":"Bringing out the fragrances…","shopAccent":"सुगंध तैयार हो रही है…","product":"Unwrapping the pack…","productAccent":"पैक खोला जा रहा है…"},"categories":{"All":"All","Incense Sticks":"Incense Sticks","Dhoop":"Dhoop","Cones":"Cones","Mosquito Repellent":"Mosquito Repellent"},"home":{"heroTitle":"The best pooja agarbatti brand in India.","heroAccent":"सुगंध जो प्रार्थना बन जाए।","heroBody":"Srikanth incense is hand-rolled with rose, sandal, mogra, lavender and forest resins — traditional fragrances made for everyday prayer, in packs from ₹7 to ₹45.","stats":[{"value":"12+","label":"Years of rolling"},{"value":"40L+","label":"Sticks made each month"},{"value":"9","label":"States served"},{"value":"300+","label":"Active dealers"}],"heroCardLabel":"Bestseller","heroCardProduct":"Chandan Incense","marquee":["Agarbatti Manufacturer","अगरबत्ती निर्माता","Natural Incense Sticks","धूप बत्ती एवं शंकु","Herbal & Floral Blends","मच्छर भगाने वाली बत्ती","Bulk & Wholesale Supply"],"bestsellersEyebrow":"Bestsellers","bestsellersAccent":"लोकप्रिय","bestsellersTitle":"Fragrances our customers reorder","viewAll":"View all {count} products","aboutEyebrow":"Know about us","aboutAccent":"हमारे बारे में","aboutTitle":"A family unit in Gaya, making incense the slow way.","aboutBody1":"SRAW Products Pvt. Ltd. builds the Srikanth brand around traditional and modern fragrances that suit different customer preferences. Our sticks are made with a blend of natural ingredients — essential oils, flowers and herbs — which gives them a distinct aroma.","aboutBody2":"From rose and sandal to mogra, jasmine, woods and guggul, every fragrance is developed in-house and tested in real homes before it reaches a shelf.","aboutCta":"More about us","promises":[{"title":"Natural ingredients","body":"Essential oils, flowers, herbs and halmaddi resin — no harsh synthetic fillers in our premium range."},{"title":"Hand-rolled daily","body":"Every batch is rolled and cured by our team in Gaya, then quality-checked before it is packed."},{"title":"Honest pricing","body":"Pack sizes from ₹7 to ₹45 so a temple, a shop and a family can all find the right box."},{"title":"Dealer support","body":"Territory protection, display material and same-week dispatch for our distribution partners."}],"stepsEyebrow":"How it is made","stepsAccent":"निर्माण प्रक्रिया","stepsTitle":"Four steps between the raw resin and your pooja thali","steps":[{"n":"01","title":"Source","body":"Bamboo sticks, jigat powder, resins and essential oils sourced from trusted Indian suppliers."},{"n":"02","title":"Blend","body":"Master perfumers build each fragrance and age the mix before rolling begins."},{"n":"03","title":"Roll & cure","body":"Sticks are hand-rolled, dipped and cured for 48 hours so the fragrance sets deep."},{"n":"04","title":"Pack & ship","body":"Sealed, labelled and dispatched from our Bihar unit to dealers across the country."}],"bulkEyebrow":"Bulk & wholesale","bulkAccent":"थोक व्यापार","bulkTitle":"Buying by the carton? Order direct from the factory.","bulkBody":"Retailers, temples, event planners and export houses get trade pricing from five cartons upwards, with private label and custom fragrance options.","bulkStats":[{"k":"5 cartons","v":"Minimum order"},{"k":"Up to 22%","v":"Trade discount"},{"k":"3 days","v":"Typical dispatch"}],"bulkCta":"See wholesale slabs","bulkCtaAlt":"Get a quote on WhatsApp","shlokaTitle":"सुगंध वह है जो मन को शांत करे,","shlokaTitle2":"और घर को मंदिर बना दे।","shlokaSub":"Fragrance that calms the mind and turns a home into a temple.","testimonialsTitle":"Trusted by shops, temples and homes","testimonials":[{"quote":"We stock Srikanth Chandan in all four of our pooja stores. The smoke is clean and customers keep coming back for the ₹25 pack.","name":"Ramesh Gupta","role":"Retailer, Patna"},{"quote":"The dhoop burns evenly and the fragrance holds for hours. We use it for our daily aarti at the temple.","name":"Sunita Devi","role":"Temple trust, Gaya"},{"quote":"Dispatch has never been late in two years of dealership. That reliability is why we expanded to three districts.","name":"Md. Arshad","role":"Distributor, Jharkhand"}],"ctaTitle":"Stock Srikanth agarbatti in your city","ctaBody":"We are appointing distributors and super-stockists across India. Share your details and our team will call you within two working days.","ctaPrimary":"Apply for dealership"},"shop":{"title":"Shop","metaDescription":"Browse Srikanth incense sticks, dhoop, cones and citronella mosquito repellent sticks in pack sizes from ₹7 to ₹45.","eyebrow":"Our store","eyebrowAccent":"हमारी दुकान","heading":"All of our products","headingAccent":"हमारे सभी उत्पाद","intro":"Eleven fragrances across incense sticks, wet dhoop, bamboo-free cones and natural mosquito repellent — each available in multiple pack sizes.","searchLabel":"Search products","searchPlaceholder":"Search rose, sandal, dhoop…","sortLabel":"Sort products","sorts":{"featured":"Featured","price-asc":"Price: low to high","price-desc":"Price: high to low","rating":"Top rated"},"showing":"Showing {visible} of {total} products","empty":"No products match that search. Try “chandan” or “dhoop”."},"product":{"breadcrumbShop":"Shop","availableIn":"Available in:","detailCategory":"Category","detailBurn":"Burn time","detailNotes":"Fragrance notes","detailMade":"Made in","madeValue":"Gaya, Bihar, India","bulkLine":"Need a bulk quote or carton pricing?","bulkLink":"See wholesale slabs","bulkOr":"or","bulkWhatsapp":"message us on WhatsApp","related":"You may also like","views":{"pack":"Front of pack","burning":"Lit in a holder","sticks":"Sticks inside","carton":"Bulk carton"}},"cart":{"title":"Your cart","loading":"Loading your cart…","emptyTitle":"Your cart is empty","emptyBody":"Add a pack of Chandan, Gulaab or Mogra and we will get it dispatched from Gaya within two working days.","browse":"Browse products","clear":"Clear cart","continue":"Continue shopping","summary":"Order summary","subtotal":"Subtotal","shipping":"Shipping","free":"Free","total":"Total","freeShippingHint":"Add {amount} more for free shipping.","orderWhatsapp":"Place order on WhatsApp","orderPhone":"Order by phone","note":"Orders are confirmed by our sales team. Payment on delivery or bank transfer for wholesale accounts.","remove":"Remove","orderIntro":"Hello SRAW Products, I would like to order:","orderTotal":"Total"},"about":{"title":"About us","metaDescription":"SRAW Products Pvt Ltd is an agarbatti manufacturer and wholesaler from Gaya, Bihar, making the Srikanth range of incense sticks, dhoop and cones.","eyebrow":"About us","heading":"Incense made by hand, for homes that pray every day.","intro":"SRAW Products Pvt. Ltd. runs the brand “Srikanth”, offering a range of traditional and modern fragrances that cater to different customer preferences.","body1":"Our agarbatti sticks are made with a blend of natural ingredients including essential oils, flowers and herbs, which gives them a distinct aroma. The Srikanth range covers rose, sandal, mogra, jasmine, woods and guggul — the fragrances Indian families have used for generations.","body2":"Everything is produced at our unit in Gaya, Bihar. Raw material arrives in sacks, the perfumery team ages each blend, and our rollers shape the sticks by hand. Nothing leaves the floor until it has been burnt, smelled and approved.","body3":"Beyond retail packs, we supply bulk and private-label incense to distributors, temples and gift-pack assemblers. If you need a custom fragrance or your own label on the box, our team can develop it with you.","cta":"Partner with us","capabilitiesTitle":"What we do","capabilities":["Agarbatti Manufacturer","Agarbatti Wholesaler","Natural Incense Stick Manufacturer","Raw Incense Stick Manufacturer","Aromatic Incense Stick Manufacturer","Floral Incense Stick Manufacturer","Herbal Incense Stick Manufacturer","Dhoop Cone Manufacturer","Mosquito Repellent Manufacturer"],"timelineTitle":"Our journey","timeline":[{"year":"2012","title":"The first batch","body":"A small rolling unit opens in Gaya with two fragrances and a handcart."},{"year":"2016","title":"Srikanth is born","body":"The Srikanth brand is registered and the ₹7 pack reaches shops across Bihar."},{"year":"2019","title":"Dhoop & cones","body":"Bamboo-free dhoop and pressed cones are added to the catalogue."},{"year":"2023","title":"Nine states","body":"A dealer network of 300+ partners carries the range beyond eastern India."}]},"contact":{"title":"Contact","metaDescription":"Call, WhatsApp or write to SRAW Products Pvt Ltd in Gaya, Bihar for retail orders, bulk supply and product enquiries.","eyebrow":"Contact","heading":"Talk to our team","intro":"Retail orders, bulk supply, private label or a simple question about a fragrance — we usually reply the same working day.","officeTitle":"Factory & office","hours":"Mon–Sat · 9:30 am to 7:00 pm","whatsapp":"WhatsApp","submit":"Send enquiry","successTitle":"Thank you — message received","successBody":"Our sales team will get back to you on the phone number you shared, usually within one working day.","consent":"By submitting you agree to be contacted about your enquiry.","fields":{"name":"Full name","namePlaceholder":"Your name","phone":"Phone","email":"Email","city":"City","cityPlaceholder":"Gaya","topic":"I am enquiring about","message":"Message","messagePlaceholder":"Tell us what you need…"},"topics":["Retail order","Bulk / wholesale supply","Private label manufacturing","Dealership","Something else"]},"dealership":{"title":"Dealership","metaDescription":"Apply for a Srikanth agarbatti distributorship. Territory protection, margins, marketing support and fast dispatch from our Bihar unit.","eyebrow":"Join dealership","heading":"Build a steady agarbatti business in your district.","intro":"Srikanth is a fast-moving, repeat-purchase category with low shelf space and reliable margins. We are appointing distributors and super-stockists across India.","benefits":[{"title":"Protected territory","body":"One appointed partner per district so your investment is never undercut."},{"title":"Healthy margins","body":"Slab-based pricing on cartons with additional quarterly performance incentives."},{"title":"Marketing support","body":"Posters, danglers, counter display boxes and sampling packs supplied free."},{"title":"Fast dispatch","body":"Orders confirmed before noon are dispatched within 48 hours from Gaya."}],"requirementsTitle":"What we look for","requirements":["GST registration and a current bank account","Godown or storage space of at least 200 sq ft","Existing distribution to kirana, pooja or general stores","Minimum first order as per the appointed slab"],"submit":"Submit application","successTitle":"Application submitted","successBody":"Our channel team will review your territory and call you within two working days.","fields":{"name":"Full name","firm":"Firm name","phone":"Phone","email":"Email","city":"City / district","state":"State","type":"Partnership type","experience":"Current business & experience","experiencePlaceholder":"Brands handled, coverage, number of outlets…"},"types":["Distributor","Super stockist","Retailer","Institutional buyer"]},"bulk":{"title":"Bulk order","metaDescription":"Wholesale and bulk agarbatti supply from SRAW Products — carton slabs, private label packing and factory dispatch from Gaya, Bihar.","eyebrow":"Bulk & wholesale","eyebrowAccent":"थोक व्यापार","heading":"Carton pricing, straight from the factory floor.","headingAccent":"सीधे फैक्ट्री से, थोक दाम पर।","intro":"We supply retailers, temples, event planners and export houses directly from our unit in Gaya — no middlemen, no minimum brand commitment beyond five cartons.","ctaPrimary":"Request a quote","ctaSecondary":"WhatsApp our sales desk","slabsTitle":"Quantity slabs","slabsNote":"One carton holds 100 retail packs. Rates apply per fragrance and are confirmed on your proforma invoice.","tableHead":{"qty":"Order quantity","discount":"Trade discount","dispatch":"Dispatch","moq":"MOQ"},"slabs":[{"qty":"5 – 24 cartons","discount":"8% off MRP","dispatch":"3 working days","moq":"5 cartons"},{"qty":"25 – 99 cartons","discount":"15% off MRP","dispatch":"3 working days","moq":"25 cartons"},{"qty":"100 – 499 cartons","discount":"22% off MRP","dispatch":"5 working days","moq":"100 cartons"},{"qty":"500+ cartons","discount":"Custom quote","dispatch":"7–10 working days","moq":"500 cartons"}],"servicesTitle":"What we can do for you","services":[{"title":"Private label","body":"Your brand name, logo and MRP printed on our packs. Artwork support included from 100 cartons."},{"title":"Custom fragrance","body":"Our perfumery team develops a blend to your brief and shares samples before the first run."},{"title":"Festival & gift packs","body":"Assorted boxes for Diwali, weddings, temple trusts and corporate gifting, packed to your spec."},{"title":"Export documentation","body":"Invoices, packing lists and pallet-ready cartons for freight forwarders and export houses."}],"faqTitle":"Common questions","faqs":[{"q":"What is the minimum bulk order?","a":"Five cartons of a single fragrance, or a mixed pallet of five cartons across the range."},{"q":"How is payment handled?","a":"50% advance by NEFT/UPI against a proforma invoice, balance before dispatch. Approved dealers get 30-day credit."},{"q":"Do you ship outside Bihar?","a":"Yes. We dispatch by road transport across nine states, and by courier for smaller consignments."}],"talkLine":"Prefer to talk?","submit":"Request bulk quote","successTitle":"Quote request received","successBody":"Our wholesale desk will send a proforma invoice with carton rates within one working day.","fields":{"name":"Contact person","firm":"Business name","phone":"Phone","email":"Email","city":"Delivery city","gst":"GSTIN","products":"Fragrances required","quantity":"Approx. cartons","message":"Packing, labelling or delivery notes","messagePlaceholder":"Private label, pack sizes, delivery date…"},"productOptions":["Incense sticks","Dhoop","Dhoop cones","Mosquito repellent sticks","Mixed assortment"],"quantityOptions":["5 – 24","25 – 99","100 – 499","500+"]},"notFound":{"eyebrow":"404","title":"This page has burnt out","body":"The page you are looking for does not exist. Try our store instead.","cta":"Go to shop"}}}],"$L4"]}],null],["$L5"],"$L6"]}],"isPartial":"$@7","staleTime":"$8","varyParams":null},{"rsc":"$L9","isPartial":"$@a","staleTime":"$8","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$8","varyParams":"$d"},{"rsc":"$Le","isPartial":"$@f","staleTime":"$8","varyParams":"$d"}],"isUpgradeableISRFallback":false,"a":"$@10","rootVaryParams":null,"needsRuntimeRequest":"$@11"}
