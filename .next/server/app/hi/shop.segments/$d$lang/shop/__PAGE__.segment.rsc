lue":"गया, बिहार, भारत","bulkLine":"थोक भाव या कार्टन दर चाहिए?","bulkLink":"थोक दर सूची देखें","bulkOr":"या","bulkWhatsapp":"व्हाट्सएप पर संदेश भेजें","related":"ये भी पसंद आ सकते हैं","views":{"pack":"पैक का अगला भाग","burning":"स्टैंड में जलती हुई","sticks":"अंदर की बत्तियाँ","carton":"थोक कार्टन"}},"cart":{"title":"आपका कार्ट","loading":"कार्ट लोड हो रहा है…","emptyTitle":"आपका कार्ट खाली है","emptyBody":"चंदन, गुलाब या मोगरा का एक पैक जोड़ें — हम इसे दो कार्यदिवस में गया से भेज देंगे।","browse":"उत्पाद देखें","clear":"कार्ट खाली करें","continue":"ख़रीदारी जारी रखें","summary":"ऑर्डर विवरण","subtotal":"उप-योग","shipping":"डिलीवरी","free":"मुफ़्त","total":"कुल","freeShippingHint":"मुफ़्त डिलीवरी के लिए {amount} और जोड़ें।","orderWhatsapp":"व्हाट्सएप पर ऑर्डर करें","orderPhone":"फ़ोन पर ऑर्डर करें","note":"ऑर्डर हमारी सेल्स टीम द्वारा पुष्ट किया जाता है। डिलीवरी पर भुगतान या थोक खातों के लिए बैंक ट्रांसफ़र।","remove":"हटाएँ","orderIntro":"नमस्ते स्रॉ प्रोडक्ट्स, मुझे यह ऑर्डर करना है:","orderTotal":"कुल"},"about":{"title":"हमारे बारे में","metaDescription":"स्रॉ प्रोडक्ट्स प्रा. लि. गया, बिहार की अगरबत्ती निर्माता एवं थोक विक्रेता कंपनी है, जो श्रीकंठ अगरबत्ती, धूप और शंकु बनाती है।","eyebrow":"हमारे बारे में","heading":"हाथ से बनी अगरबत्ती, उन घरों के लिए जो रोज़ पूजा करते हैं।","intro":"स्रॉ प्रोडक्ट्स प्रा. लि. “श्रीकंठ” ब्रांड चलाती है, जो अलग-अलग पसंद के ग्राहकों के लिए पारंपरिक और आधुनिक सुगंध प्रदान करता है।","body1":"हमारी अगरबत्तियाँ सुगंधित तेल, फूल और जड़ी-बूटियों सहित प्राकृतिक सामग्री के मिश्रण से बनती हैं, जो उन्हें विशेष महक देती है। श्रीकंठ श्रृंखला में गुलाब, चंदन, मोगरा, चमेली, वन काष्ठ और गुग्गुल शामिल हैं — वही सुगंध जो पीढ़ियों से भारतीय परिवार उपयोग करते आए हैं।","body2":"सब कुछ गया, बिहार की हमारी इकाई में बनता है। कच्चा माल बोरियों में आता है, सुगंध टीम हर मिश्रण को पकाती है और कारीगर बत्तियाँ हाथ से बनाते हैं। जलाकर, सूँघकर और स्वीकृत होने के बाद ही माल बाहर जाता है।","body3":"खुदरा पैक के अलावा हम वितरकों, मंदिरों और गिफ़्ट पैक बनाने वालों को थोक तथा निजी लेबल अगरबत्ती देते हैं। यदि आपको अपनी सुगंध या अपना लेबल चाहिए, हमारी टीम आपके साथ मिलकर बनाएगी।","cta":"हमारे साझेदार बनें","capabilitiesTitle":"हम क्या करते हैं","capabilities":["अगरबत्ती निर्माता","अगरबत्ती थोक विक्रेता","प्राकृतिक अगरबत्ती निर्माता","रॉ अगरबत्ती निर्माता","सुगंधित अगरबत्ती निर्माता","पुष्प अगरबत्ती निर्माता","हर्बल अगरबत्ती निर्माता","धूप शंकु निर्माता","मच्छर भगाने वाली बत्ती निर्माता"],"timelineTitle":"हमारी यात्रा","timeline":[{"year":"2012","title":"पहला बैच","body":"गया में दो सुगंध और एक ठेले के साथ छोटी इकाई शुरू हुई।"},{"year":"2016","title":"श्रीकंठ का जन्म","body":"श्रीकंठ ब्रांड पंजीकृत हुआ और ₹7 का पैक पूरे बिहार की दुकानों तक पहुँचा।"},{"year":"2019","title":"धूप एवं शंकु","body":"बाँस रहित धूप और दबाए हुए शंकु उत्पाद सूची में जुड़े।"},{"year":"2023","title":"नौ राज्य","body":"300+ साझेदारों का डीलर नेटवर्क पूर्वी भारत के बाहर भी पहुँचा।"}]},"contact":{"title":"संपर्क","metaDescription":"खुदरा ऑर्डर, थोक आपूर्ति और उत्पाद संबंधी पूछताछ के लिए गया, बिहार स्थित स्रॉ प्रोडक्ट्स को कॉल, व्हाट्सएप या ईमेल करें।","eyebrow":"संपर्क","heading":"हमारी टीम से बात करें","intro":"खुदरा ऑर्डर, थोक आपूर्ति, निजी लेबल या किसी सुगंध से जुड़ा सवाल — हम आमतौर पर उसी कार्यदिवस में उत्तर देते हैं।","officeTitle":"फैक्ट्री एवं कार्यालय","hours":"सोम–शनि · सुबह 9:30 से शाम 7:00 बजे तक","whatsapp":"व्हाट्सएप","submit":"पूछताछ भेजें","successTitle":"धन्यवाद — संदेश मिल गया","successBody":"हमारी सेल्स टीम आपके दिए नंबर पर आमतौर पर एक कार्यदिवस में संपर्क करेगी।","consent":"फ़ॉर्म भेजने का अर्थ है कि आप संपर्क किए जाने से सहमत हैं।","fields":{"name":"पूरा नाम","namePlaceholder":"आपका नाम","phone":"फ़ोन","email":"ईमेल","city":"शहर","cityPlaceholder":"गया","topic":"पूछताछ का विषय","message":"संदेश","messagePlaceholder":"बताइए आपको क्या चाहिए…"},"topics":["खुदरा ऑर्डर","थोक आपूर्ति","निजी लेबल निर्माण","डीलरशिप","अन्य"]},"dealership":{"title":"डीलरशिप","metaDescription":"श्रीकंठ अगरबत्ती की डीलरशिप के लिए आवेदन करें। क्षेत्र सुरक्षा, बेहतर मार्जिन, प्रचार सहयोग और बिहार इकाई से तेज़ डिस्पैच।","eyebrow":"डीलरशिप से जुड़ें","heading":"अपने ज़िले में स्थिर अगरबत्ती व्यापार बनाएँ।","intro":"श्रीकंठ तेज़ बिकने वाली, बार-बार ख़रीदी जाने वाली श्रेणी है — कम जगह, भरोसेमंद मार्जिन। हम पूरे भारत में वितरक और सुपर स्टॉकिस्ट नियुक्त कर रहे हैं।","benefits":[{"title":"सुरक्षित क्षेत्र","body":"हर ज़िले में एक ही साझेदार, ताकि आपके निवेश पर कोई असर न पड़े।"},{"title":"बेहतर मार्जिन","body":"कार्टन पर स्लैब आधारित दाम और तिमाही प्रदर्शन प्रोत्साहन।"},{"title":"प्रचार सहयोग","body":"पोस्टर, डैंगलर, काउंटर डिस्प्ले बॉक्स और सैंपल पैक निःशुल्क।"},{"title":"तेज़ डिस्पैच","body":"दोपहर से पहले पुष्ट ऑर्डर गया से 48 घंटे में रवाना।"}],"requirementsTitle":"हमें क्या चाहिए","requirements":["जीएसटी पंजीकरण और चालू बैंक खाता","कम से कम 200 वर्ग फुट का गोदाम","किराना, पूजा या जनरल स्टोर तक मौजूदा वितरण","निर्धारित स्लैब के अनुसार न्यूनतम पहला ऑर्डर"],"submit":"आवेदन भेजें","successTitle":"आवेदन प्राप्त हुआ","successBody":"हमारी चैनल टीम आपके क्षेत्र की समीक्षा कर दो कार्यदिवस में कॉल करेगी।","fields":{"name":"पूरा नाम","firm":"फर्म का नाम","phone":"फ़ोन","email":"ईमेल","city":"शहर / ज़िला","state":"राज्य","type":"साझेदारी का प्रकार","experience":"वर्तमान व्यापार एवं अनुभव","experiencePlaceholder":"कौन से ब्रांड, कितना क्षेत्र, कितनी दुकानें…"},"types":["वितरक","सुपर स्टॉकिस्ट","खुदरा विक्रेता","संस्थागत ख़रीदार"]},"bulk":{"title":"थोक ऑर्डर","metaDescription":"स्रॉ प्रोडक्ट्स से थोक अगरबत्ती आपूर्ति — कार्टन स्लैब, निजी लेबल पैकिंग और गया, बिहार से सीधा डिस्पैच।","eyebrow":"थोक व्यापार","eyebrowAccent":"","heading":"सीधे फैक्ट्री से, कार्टन के दाम पर।","headingAccent":"","intro":"हम दुकानदारों, मंदिरों, इवेंट प्लानरों और निर्यात घरानों को गया स्थित इकाई से सीधे आपूर्ति करते हैं — कोई बिचौलिया नहीं, न्यूनतम पाँच कार्टन।","ctaPrimary":"भाव पूछें","ctaSecondary":"व्हाट्सएप पर संपर्क करें","slabsTitle":"मात्रा स्लैब","slabsNote":"एक कार्टन में 100 खुदरा पैक होते हैं। दरें प्रति सुगंध लागू होती हैं और प्रोफ़ॉर्मा इनवॉइस पर पुष्ट की जाती हैं।","tableHead":{"qty":"ऑर्डर मात्रा","discount":"व्यापारिक छूट","dispatch":"डिस्पैच","moq":"न्यूनतम मात्रा"},"slabs":[{"qty":"5 – 24 कार्टन","discount":"एमआरपी पर 8% छूट","dispatch":"3 कार्यदिवस","moq":"5 कार्टन"},{"qty":"25 – 99 कार्टन","discount":"एमआरपी पर 15% छूट","dispatch":"3 कार्यदिवस","moq":"25 कार्टन"},{"qty":"100 – 499 कार्टन","discount":"एमआरपी पर 22% छूट","dispatch":"5 कार्यदिवस","moq":"100 कार्टन"},{"qty":"500+ कार्टन","discount":"विशेष भाव","dispatch":"7–10 कार्यदिवस","moq":"500 कार्टन"}],"servicesTitle":"हम आपके लिए क्या कर सकते हैं","services":[{"title":"निजी लेबल","body":"हमारे पैक पर आपका ब्रांड, लोगो और एमआरपी। 100 कार्टन से आर्टवर्क सहयोग शामिल।"},{"title":"विशेष सुगंध","body":"हमारी सुगंध टीम आपकी माँग के अनुसार मिश्रण बनाती है और पहले रन से पहले सैंपल भेजती है।"},{"title":"त्योहार एवं गिफ़्ट पैक","body":"दीवाली, शादी, मंदिर ट्रस्ट और कॉर्पोरेट गिफ़्टिंग के लिए मिश्रित डिब्बे, आपकी माँग के अनुसार।"},{"title":"निर्यात दस्तावेज़","body":"इनवॉइस, पैकिंग लिस्ट और पैलेट-तैयार कार्टन — फ्रेट फॉरवर्डर और निर्यात घरानों के लिए।"}],"faqTitle":"आम सवाल","faqs":[{"q":"न्यूनतम थोक ऑर्डर कितना है?","a":"एक सुगंध के पाँच कार्टन, या पूरी श्रृंखला से मिलाकर पाँच कार्टन।"},{"q":"भुगतान कैसे होता है?","a":"प्रोफ़ॉर्मा इनवॉइस पर 50% अग्रिम NEFT/UPI से, शेष डिस्पैच से पहले। स्वीकृत डीलरों को 30 दिन की उधारी।"},{"q":"क्या बिहार के बाहर भेजते हैं?","a":"हाँ। नौ राज्यों में सड़क परिवहन से और छोटी खेप कूरियर से भेजते हैं।"}],"talkLine":"बात करना चाहेंगे?","submit":"थोक भाव माँगें","successTitle":"आपका अनुरोध मिल गया","successBody":"हमारा थोक विभाग एक कार्यदिवस में कार्टन दरों सहित प्रोफ़ॉर्मा इनवॉइस भेजेगा।","fields":{"name":"संपर्क व्यक्ति","firm":"व्यापार का नाम","phone":"फ़ोन","email":"ईमेल","city":"डिलीवरी शहर","gst":"जीएसटीआईएन","products":"आवश्यक सुगंध","quantity":"अनुमानित कार्टन","message":"पैकिंग, लेबलिंग या डिलीवरी संबंधी बातें","messagePlaceholder":"निजी लेबल, पैक आकार, डिलीवरी तिथि…"},"productOptions":["अगरबत्ती","धूप","धूप शंकु","मच्छर भगाने वाली बत्