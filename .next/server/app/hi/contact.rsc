Incense Sticks":"अगरबत्ती","Dhoop":"धूप","Cones":"धूप शंकु","Mosquito Repellent":"मच्छर भगाने वाली बत्ती"},"home":{"heroTitle":"भारत का सर्वश्रेष्ठ पूजा अगरबत्ती ब्रांड।","heroAccent":"सुगंध जो प्रार्थना बन जाए।","heroBody":"श्रीकंठ अगरबत्ती गुलाब, चंदन, मोगरा, लैवेंडर और वन राल से हाथ से बनाई जाती है — रोज़ की पूजा के लिए पारंपरिक सुगंध, ₹7 से ₹45 तक के पैक में।","stats":[{"value":"12+","label":"वर्षों का अनुभव"},{"value":"40L+","label":"बत्तियाँ हर माह"},{"value":"9","label":"राज्यों में आपूर्ति"},{"value":"300+","label":"सक्रिय डीलर"}],"heroCardLabel":"सबसे लोकप्रिय","heroCardProduct":"चंदन अगरबत्ती","marquee":["अगरबत्ती निर्माता","प्राकृतिक अगरबत्ती","धूप बत्ती एवं शंकु","हर्बल एवं पुष्प सुगंध","मच्छर भगाने वाली बत्ती","थोक आपूर्ति","निजी लेबल पैकिंग"],"bestsellersEyebrow":"सबसे लोकप्रिय","bestsellersAccent":"","bestsellersTitle":"जिन्हें ग्राहक बार-बार मँगाते हैं","viewAll":"सभी {count} उत्पाद देखें","aboutEyebrow":"हमारे बारे में","aboutAccent":"","aboutTitle":"गया की एक पारिवारिक इकाई, जहाँ अगरबत्ती धीरे-धीरे बनती है।","aboutBody1":"स्रॉ प्रोडक्ट्स प्रा. लि. का ब्रांड “श्रीकंठ” पारंपरिक और आधुनिक — दोनों तरह की सुगंध प्रदान करता है। हमारी बत्तियाँ प्राकृतिक सामग्री, सुगंधित तेल, फूल और जड़ी-बूटियों के मिश्रण से बनती हैं, जो उन्हें विशेष महक देती है।","aboutBody2":"गुलाब और चंदन से लेकर मोगरा, चमेली, वन काष्ठ और गुग्गुल तक — हर सुगंध हमारे यहाँ ही तैयार होती है और दुकान तक पहुँचने से पहले असली घरों में परखी जाती है।","aboutCta":"और जानें","promises":[{"title":"प्राकृतिक सामग्री","body":"सुगंधित तेल, फूल, जड़ी-बूटियाँ और हलमद्दी राल — हमारी प्रीमियम श्रेणी में कोई कठोर रसायन नहीं।"},{"title":"रोज़ हाथ से निर्मित","body":"हर बैच हमारी गया इकाई में हाथ से बनता है और पैकिंग से पहले गुणवत्ता जाँच से गुज़रता है।"},{"title":"ईमानदार दाम","body":"₹7 से ₹45 तक के पैक — मंदिर, दुकान और परिवार, सभी के लिए सही डिब्बा।"},{"title":"डीलर सहयोग","body":"क्षेत्र सुरक्षा, प्रचार सामग्री और उसी सप्ताह डिस्पैच — हमारे वितरण साझेदारों के लिए।"}],"stepsEyebrow":"निर्माण प्रक्रिया","stepsAccent":"","stepsTitle":"कच्ची राल से आपकी पूजा थाली तक — चार चरण","steps":[{"n":"०१","title":"सामग्री","body":"बाँस की सींक, जिगात पाउडर, राल और सुगंधित तेल भरोसेमंद भारतीय आपूर्तिकर्ताओं से।"},{"n":"०२","title":"मिश्रण","body":"हमारे सुगंध विशेषज्ञ हर फ़ॉर्मूला तैयार करते हैं और रोलिंग से पहले उसे पकने देते हैं।"},{"n":"०३","title":"रोलिंग एवं सुखाई","body":"बत्तियाँ हाथ से लपेटी जाती हैं और 48 घंटे सुखाई जाती हैं ताकि सुगंध गहरी बैठे।"},{"n":"०४","title":"पैकिंग एवं डिस्पैच","body":"सील, लेबल और हमारी बिहार इकाई से पूरे देश के डीलरों तक रवाना।"}],"bulkEyebrow":"थोक व्यापार","bulkAccent":"","bulkTitle":"कार्टन में ख़रीद रहे हैं? सीधे फैक्ट्री से मँगाएँ।","bulkBody":"दुकानदार, मंदिर, इवेंट प्लानर और निर्यातक पाँच कार्टन से ही व्यापारिक दाम पा सकते हैं — निजी लेबल और विशेष सुगंध के विकल्प के साथ।","bulkStats":[{"k":"5 कार्टन","v":"न्यूनतम ऑर्डर"},{"k":"22% तक","v":"व्यापारिक छूट"},{"k":"3 दिन","v":"सामान्य डिस्पैच"}],"bulkCta":"थोक दर सूची देखें","bulkCtaAlt":"व्हाट्सएप पर भाव लें","shlokaTitle":"सुगंध वह है जो मन को शांत करे,","shlokaTitle2":"और घर को मंदिर बना दे।","shlokaSub":"श्रीकंठ — हर घर की पूजा का साथी।","testimonialsTitle":"दुकानों, मंदिरों और घरों का भरोसा","testimonials":[{"quote":"हमारी चारों पूजा दुकानों में श्रीकंठ चंदन रखते हैं। धुआँ साफ़ है और ग्राहक ₹25 का पैक बार-बार माँगते हैं।","name":"रमेश गुप्ता","role":"दुकानदार, पटना"},{"quote":"धूप एक समान जलती है और सुगंध घंटों बनी रहती है। मंदिर की रोज़ की आरती में यही उपयोग करते हैं।","name":"सुनीता देवी","role":"मंदिर ट्रस्ट, गया"},{"quote":"दो साल की डीलरशिप में डिस्पैच कभी देर से नहीं आया। इसी भरोसे पर हमने तीन ज़िलों तक विस्तार किया।","name":"मो. अरशद","role":"वितरक, झारखंड"}],"ctaTitle":"अपने शहर में श्रीकंठ अगरबत्ती रखें","ctaBody":"हम पूरे भारत में वितरक और सुपर स्टॉकिस्ट नियुक्त कर रहे हैं। विवरण भेजें, हमारी टीम दो कार्यदिवस में कॉल करेगी।","ctaPrimary":"डीलरशिप के लिए आवेदन करें"},"shop":{"title":"उत्पाद","metaDescription":"श्रीकंठ अगरबत्ती, धूप, शंकु और सिट्रोनेला मच्छर भगाने वाली बत्ती 